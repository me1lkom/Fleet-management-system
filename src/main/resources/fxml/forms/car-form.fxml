<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ru.mirea.project.car.controller.CarFormController"
        spacing="8"
        style="-fx-padding: 16;"
        prefWidth="500"
>
    <Label
            text="Бренд*"
            styleClass="select-title"
    />
    <TextField
            fx:id="brandTextField"
            promptText="Введите бренд..."
    />

    <Label
            text="Модель*"
            styleClass="select-title"
    />
    <TextField
            fx:id="modelTextField"
            promptText="Введите модель..."
    />

    <Label
            text="Трансмиссия*"
            styleClass="select-title"
    />
    <ComboBox
            fx:id="transmissionComboBox"
            promptText="Выберите трансмиссию..."
            maxWidth="Infinity"
    />

    <Label
            text="Год*"
            styleClass="select-title"
    />
    <TextField
            fx:id="yearTextField"
            promptText="Введите год..."
    />

    <Label
            text="Гос Номер*"
            styleClass="select-title"
    />
    <TextField
            fx:id="licensePlateTextField"
            promptText="Введите гос номер..."
    />

    <Label
            text="Тип кузова*"
            styleClass="select-title"
    />
    <ComboBox
            fx:id="bodyTypeComboBox"
            promptText="Выберите тип кузова..."
            maxWidth="Infinity"
    />

    <Label
            text="Статус*"
            styleClass="select-title"
    />
    <ComboBox
            fx:id="carStatusComboBox"
            promptText="Выберите текущий статус..."
            maxWidth="Infinity"
    />


    <Label
            text="Пробег*"
            styleClass="select-title"
    />
    <TextField
            fx:id="mileageTextField"
            promptText="Введите пробег..."
    />

    <Label
            text=""
            fx:id="errorLabel"
            style="-fx-text-fill: #b91c1c;"
    />

    <HBox spacing="10">
        <Button fx:id="submitButton" text="Сохранить" onAction="#handleSubmitButton"/>
        <Button fx:id="closeButton" text="Отмена" onAction="#handleClose"/>
    </HBox>
</VBox>
