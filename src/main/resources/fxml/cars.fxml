<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<VBox
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ru.mirea.project.car.controller.CarController">
   <HBox>
       <Button mnemonicParsing="false" text="Добавить" onAction="#handleOpenAddForm"/>
       <Button mnemonicParsing="false" text="Изменить" onAction="#handleOpenChangeForm"/>
       <Button mnemonicParsing="false" text="Удалить" onAction="#handleDelete"/>
       <Button mnemonicParsing="false" text="Обновить" onAction="#refreshTable"/>
   </HBox>
    <HBox>
        <ComboBox fx:id="searchFieldComboBox" promptText="Выберите">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Госномер" />
                    <String fx:value="Марка" />
                    <String fx:value="Модель" />
                </FXCollections>
            </items>
        </ComboBox>
        <TextField fx:id="searchTextField" promptText="Введите запрос..."/>
        <Button onAction="#handleSearch" text="Поиск"/>
    </HBox>
    <HBox>
        <Label text="Фильтры"/>

        <Label text="Тип кузова" labelFor="$filterBodyTypeComboBox"/>
        <ComboBox fx:id="filterBodyTypeComboBox"/>
        <Label text="Статус" labelFor="$filterStatusColumnComboBox" />
        <ComboBox fx:id="filterStatusColumnComboBox"/>
        <Button onAction="#handleApplyFilter" text="Применить"/>
        <Button onAction="#handleResetFilter" text="Сбросить" />

        <Label labelFor="$downloadCarsButton" text="Экспортировать"/>
        <Button fx:id="downloadCarsButton" onAction="#handleDownloadCars" text="Скачать"/>
    </HBox>
    <TableView fx:id="carsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" />
            <TableColumn fx:id="brandColumn" text="Марка" />
            <TableColumn fx:id="modelColumn" text="Модель" />
            <TableColumn fx:id="transmissionColumn" text="Трансмиссия" />
            <TableColumn fx:id="yearColumn" text="Год" />
            <TableColumn fx:id="licensePlateColumn" text="Номер" />
            <TableColumn fx:id="bodyTypeColumn" text="Тип кузова" />
            <TableColumn fx:id="statusColumn" text="Статус" />
            <TableColumn fx:id="mileageColumn" text="Пробег" />
        </columns>
    </TableView>
</VBox>
