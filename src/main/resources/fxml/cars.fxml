<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.mirea.project.car.controller.CarController">
   <HBox>
       <Button mnemonicParsing="false" text="Добавить" />
       <Button mnemonicParsing="false" text="Изменить" />
       <Button mnemonicParsing="false" text="Удалить" />
       <Button mnemonicParsing="false" text="Обновить" onAction="#refreshTable"/>
   </HBox>
    <TableView fx:id="carsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" />
            <TableColumn fx:id="brandColumn" text="Марка" />
            <TableColumn fx:id="modelColumn" text="Модель" />
            <TableColumn fx:id="transmissionColumn" text="Трансмиссия" />
            <TableColumn fx:id="yearColumn" text="Год" />
            <TableColumn fx:id="licensePlateColumn" text="Номер" />
            <TableColumn fx:id="bodyTypeColumn" text="Тип кузова" />
            <TableColumn fx:id="statusColumn" text="Статус" />
            <TableColumn fx:id="mileageColumn" text="Пробег" />
        </columns>
    </TableView>
</VBox>
