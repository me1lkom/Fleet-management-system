<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>

<TabPane xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="ru.mirea.project.fx.MainController"
         prefWidth="1000"
         prefHeight="650"
         tabClosingPolicy="UNAVAILABLE">

    <tabs>
        <Tab text="Обзор">
            <content>
                <fx:include source="overview.fxml" />
            </content>
        </Tab>

        <Tab text="Автомобили">
            <content>
                <fx:include source="cars.fxml"/>
            </content>
        </Tab>

        <Tab text="Пользователи">
            <content>
                <fx:include source="users.fxml"/>
            </content>
        </Tab>

        <Tab text="Заявки">
            <content>
                <fx:include source="requests.fxml"/>
            </content>
        </Tab>
    </tabs>

</TabPane>
